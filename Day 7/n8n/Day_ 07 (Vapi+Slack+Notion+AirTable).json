    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\n\nconst client_name = body.client_name || body.message?.toolCalls?.[0]?.function?.arguments?.client_name || \"Hafiz Ahmed\";\nconst company_name = body.company_name || body.message?.toolCalls?.[0]?.function?.arguments?.company_name || \"Lekki Group\";\nconst email = body.email || body.message?.toolCalls?.[0]?.function?.arguments?.email || \"ahmad@lekki.com\";\nconst service_required = body.service_required || body.message?.toolCalls?.[0]?.function?.arguments?.service_required || \"AI Chatbot\";\nconst project_description = body.project_description || body.message?.toolCalls?.[0]?.function?.arguments?.project_description || \"Chatbot for ordering\";\nlet budget_raw = body.budget || body.message?.toolCalls?.[0]?.function?.arguments?.budget || 2000;\n\n// Convert USD to PKR (Assuming 1 USD ≈ 280 PKR) if value is under 10000\nlet budget_in_pkr = Number(budget_raw);\nif (budget_in_pkr < 10000) {\n  budget_in_pkr = budget_in_pkr * 280; \n}\n\n// Priority Logic\nlet priority = \"LOW\";\nlet header_title = \"STANDARD CLIENT\";\n\nif (budget_in_pkr >= 500000) {\n  priority = \"HIGH\";\n  header_title = \"HIGH PRIORITY CLIENT\";\n} else if (budget_in_pkr >= 200000) {\n  priority = \"MEDIUM\";\n  header_title = \"MEDIUM PRIORITY CLIENT\";\n}\n\nlet service_category = \"Software & Automation\";\nif (service_required.toLowerCase().includes(\"web\") || service_required.toLowerCase().includes(\"mobile\") || service_required.toLowerCase().includes(\"app\")) {\n  service_category = \"Web & Mobile Development\";\n}\n\nreturn [{\n  json: {\n    client_name,\n    company_name,\n    email,\n    service_required,\n    service_category,\n    project_description,\n    budget_original: budget_raw,\n    budget_pkr: budget_in_pkr,\n    priority,\n    header_title,\n    summary: `${company_name} requires ${service_required.toLowerCase()}.`,\n    next_action: \"Schedule technical consultation\",\n    status: \"New\",\n    created_at: new Date().toISOString()\n  }\n}];"
      },
